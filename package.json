{
  "name": "kids-learning-companion",
  "private": true,
  "version": "0.35.0",
  "type": "module",
  "description": "Kids Learning Companion - 幼小衔接识字数字伴侣 (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "verify:decoys": "esbuild scripts/verify-decoys.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-decoys.mjs --log-level=warning && node node_modules/.cache/verify-decoys.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
